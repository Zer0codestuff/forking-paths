{
  "name": "forking-paths",
  "version": "0.1.0",
  "description": "Inspect how analytical choices change a ranking or a statistical finding, and export evidence that reproduces every result.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Gabriele Monni",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:runtime": "node scripts/fetch-runtime.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:py": "python3 -m pytest -q engine/tests",
    "ui-check": "node scripts/ui-check.mjs",
    "bench": "python3 bench/bench.py",
    "bench:browser": "node scripts/browser-bench.mjs",
    "reproduce": "bash scripts/reproduce-clean.sh"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.1.1",
    "@fontsource/martian-mono": "^5.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.49.0",
    "pyodide": "314.0.7",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
